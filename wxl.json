{
  "manifest": 1,

  "extension": {
    "id": "wxl-wrathclassicapi",
    "version": "1.4.0",
    "abi": "1.1",
    "entry": "wxl-wrathclassicapi.dll",

    "hooks": []
  },

  "deploy": {
    "mode": "release",
    "match": "*.dll"
  },

  "listing": {
    "title": "WrathClassicAPI",
